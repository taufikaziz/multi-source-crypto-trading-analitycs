# ==============================================================================
# Airflow Docker Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to .env, fill in the values, and keep it local.
# DO NOT commit .env with real secrets to version control!
# ==============================================================================

AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=indodax-airflow:3.3.1-custom

# ------------------------------------------------------------------------------
# Airflow Metadata Postgres
# ------------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=airflow

# ------------------------------------------------------------------------------
# Application Postgres (Transactional database: users, accounts, orders, trades)
# ------------------------------------------------------------------------------
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_APP_DB=indodax
POSTGRES_APP_HOST=postgres-app
POSTGRES_APP_PORT=5432
POSTGRES_APP_DSN=postgresql://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@${POSTGRES_APP_HOST}:${POSTGRES_APP_PORT}/${POSTGRES_APP_DB}

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongodb
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MONGO_INITDB_DATABASE=indodax

# ------------------------------------------------------------------------------
# MinIO (Object Storage)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
BRONZE_STORAGE_BACKEND=minio
BRONZE_MINIO_BASE_PATH=bronze

# ------------------------------------------------------------------------------
# Airflow Core
# ------------------------------------------------------------------------------
PYTHONPATH=/opt/airflow

AIRFLOW__CORE__EXECUTOR=LocalExecutor

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_FERNET_KEY

AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# ------------------------------------------------------------------------------
# Airflow Auth
# ------------------------------------------------------------------------------
# Format: username:role
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=False

# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(24)).decode())"
AIRFLOW__API__SECRET_KEY=REPLACE_WITH_API_SECRET
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_JWT_SECRET

# ------------------------------------------------------------------------------
# Airflow API / Execution
# ------------------------------------------------------------------------------
AIRFLOW__API__BASE_URL=http://localhost:8080
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/

# ------------------------------------------------------------------------------
# MongoDB Connection (for Airflow & ingestion)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_INITDB_DATABASE}?authSource=admin

# ------------------------------------------------------------------------------
# MinIO (S3-compatible) Configuration
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=indodax-data

# ------------------------------------------------------------------------------
# Databricks
# ------------------------------------------------------------------------------
DATABRICKS_SERVER_HOSTNAME=REPLACE_WITH_DATABRICKS_HOSTNAME
DATABRICKS_HTTP_PATH=REPLACE_WITH_HTTP_PATH

# Generate a Personal Access Token from Databricks Settings -> Developer
DATABRICKS_TOKEN=REPLACE_WITH_DATABRICKS_TOKEN
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=marts
