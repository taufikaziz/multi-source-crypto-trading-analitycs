services:

  postgres:
    image: postgres:16-alpine
    container_name: indodax-airflow-postgres

    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}

    volumes:
      - postgres_data:/var/lib/postgresql/data

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"
        ]
      interval: 5s
      timeout: 5s
      retries: 10

    restart: unless-stopped


  airflow-api-server:
    build:
      context: .
      dockerfile: Dockerfile

    image: ${AIRFLOW_IMAGE_NAME}

    container_name: indodax-airflow-api

    depends_on:
      postgres:
        condition: service_healthy

    env_file:
      - .env

    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor

      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: ${AIRFLOW__DATABASE__SQL_ALCHEMY_CONN}

      AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW__CORE__FERNET_KEY}

      AIRFLOW__CORE__LOAD_EXAMPLES: "False"

      AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: "True"

      AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS: ${AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS}

      AIRFLOW__API__BASE_URL: ${AIRFLOW__API__BASE_URL}

      AIRFLOW__CORE__EXECUTION_API_SERVER_URL: ${AIRFLOW__CORE__EXECUTION_API_SERVER_URL}

    volumes:
      - ./dags:/opt/airflow/dags
      - ./logs:/opt/airflow/logs
      - ../:/opt/airflow/src:ro

    ports:
      - "8080:8080"

    command:
      [
        "airflow",
        "api-server",
        "--host",
        "0.0.0.0",
        "--port",
        "8080"
      ]

    restart: unless-stopped


  airflow-scheduler:
    image: ${AIRFLOW_IMAGE_NAME}

    container_name: indodax-airflow-scheduler

    depends_on:
      postgres:
        condition: service_healthy

    env_file:
      - .env

    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor

      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: ${AIRFLOW__DATABASE__SQL_ALCHEMY_CONN}

      AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW__CORE__FERNET_KEY}

      AIRFLOW__CORE__LOAD_EXAMPLES: "False"

      AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: "True"

      AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS: ${AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS}

      AIRFLOW__CORE__EXECUTION_API_SERVER_URL: ${AIRFLOW__CORE__EXECUTION_API_SERVER_URL}

    volumes:
      - ./dags:/opt/airflow/dags
      - ./logs:/opt/airflow/logs
      - ../:/opt/airflow/src:ro

    command:
      [
        "airflow",
        "scheduler"
      ]

    restart: unless-stopped


  airflow-dag-processor:
    image: ${AIRFLOW_IMAGE_NAME}

    container_name: indodax-airflow-dag-processor

    depends_on:
      postgres:
        condition: service_healthy

    env_file:
      - .env

    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor

      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: ${AIRFLOW__DATABASE__SQL_ALCHEMY_CONN}

      AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW__CORE__FERNET_KEY}

      AIRFLOW__CORE__LOAD_EXAMPLES: "False"

    volumes:
      - ./dags:/opt/airflow/dags
      - ./logs:/opt/airflow/logs
      - ../:/opt/airflow/src:ro

    command:
      [
        "airflow",
        "dag-processor"
      ]

    restart: unless-stopped


volumes:
  postgres_data:
